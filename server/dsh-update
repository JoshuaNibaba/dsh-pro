#!/usr/bin/env bash
# dsh-update [VERSION] [--no-restart]: install @deepseek-ai/dsh@VERSION (default latest)
# globally and restart dsh-web. npm 11+ skips dependency install scripts unless
# approved, so the native ones dsh needs are run explicitly.
set -euo pipefail
VERSION=latest RESTART=1
for a in "$@"; do
  case "$a" in --no-restart) RESTART=0 ;; *) VERSION="$a" ;; esac
done
export PATH=/usr/local/bin:$PATH
log="$(mktemp)"
npm i -g "@deepseek-ai/dsh@$VERSION" --no-fund --no-audit >"$log" 2>&1 || { cat "$log" >&2; rm -f "$log"; exit 1; }
rm -f "$log"
B="$(npm root -g)/@deepseek-ai/dsh/node_modules"
run() { [ -d "$B/$1" ] && (cd "$B/$1" && shift && "$@") >/dev/null 2>&1 || true; }
run @deepseek-ai/dsh-subprocess-local node scripts/ensure-spawn-helper.mjs
run node-pty sh -c 'node scripts/prebuild.js || npx -y node-gyp rebuild; node scripts/post-install.js'
run koffi node ./cnoke.cjs -P . -D src/koffi --prebuild --release
run protobufjs node scripts/postinstall
[ "$RESTART" = 1 ] && systemctl restart dsh-web
dsh --version
